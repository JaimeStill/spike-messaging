{
  "log": {
    "level": "info",
    "format": "text"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8081,
    "read_timeout": "1m",
    "read_header_timeout": "5s",
    "write_timeout": "15m",
    "idle_timeout": "2m"
  },
  "database": {
    "name": "exercise",
    "user": "app",
    "options": {
      "sslmode": "disable"
    }
  },
  "messaging": {
    "url": "nats://127.0.0.1:4222",
    "stream": "exercise",
    "prefix": "exercise",
    "max_age": "24h",
    "source": "/exercise",
    "relay_poll": "250ms"
  },
  "reads": {
    "default_size": 20,
    "max_size": 100
  },
  "shutdown_timeout": "10s"
}
